# .bashrc.d/90-prompt - Shell prompt configuration
# This file is managed by ansible - user customizations go in ~/.bashrc.d/99-user
#
# http://tldp.org/HOWTO/Bash-Prompt-HOWTO/x329.html

# --- Base palette (PS1 inline format) ---
BLACK='\[\033[0;30m\]'
BLUE='\[\033[0;34m\]'
GREEN='\[\033[0;32m\]'
CYAN='\[\033[0;36m\]'
RED='\[\033[0;31m\]'
PURPLE='\[\033[0;35m\]'
BROWN='\[\033[0;33m\]'
LIGHT_GRAY='\[\033[0;37m\]'
DARK_GRAY='\[\033[1;30m\]'
LIGHT_BLUE='\[\033[1;34m\]'
LIGHT_GREEN='\[\033[1;32m\]'
LIGHT_CYAN='\[\033[1;36m\]'
LIGHT_RED='\[\033[1;31m\]'
LIGHT_PURPLE='\[\033[1;35m\]'
YELLOW='\[\033[1;33m\]'
WHITE='\[\033[1;37m\]'
NO_COLOR='\[\033[0m\]'

# --- Semantic colors (PS1 inline, used in export PS1="..." and awk/sed) ---
C_HOSTNAME=$LIGHT_GREEN
C_BRANCH_WARN=$LIGHT_RED
C_BRANCH_OTHER=$LIGHT_CYAN
C_PWD=$LIGHT_CYAN
C_PROMPT=$RED
C_OC_USER=$LIGHT_BLUE
C_OC_USER_WARN=$LIGHT_RED
C_OC_AT=$YELLOW
C_OC_HOST=$RED
C_OC_OTHER=$YELLOW
C_OCM_ENV=$LIGHT_PURPLE
C_SANDBOX_LOCAL=$LIGHT_GRAY
C_SANDBOX_PERSONAL=$LIGHT_PURPLE
C_SANDBOX_WORK=$BROWN

# --- Function-safe colors (for PS1 helper functions called via $()) ---
# PS1 escape expansion converts \[\033[...\] for inline content, but function
# output bypasses that processor. Functions need actual \x01/ESC/\x02 bytes.
# _ps1_to_func derives them from C_* — one source of truth for color values.
_ps1_to_func() {
    local s="$1" x01=$'\x01' x02=$'\x02' esc=$'\e'
    s="${s//\\[/${x01}}"
    s="${s//\\]/${x02}}"
    s="${s//\\033/${esc}}"
    printf '%s' "$s"
}

PS1F_HOSTNAME=$(_ps1_to_func "$C_HOSTNAME")
PS1F_BRANCH_WARN=$(_ps1_to_func "$C_BRANCH_WARN")
PS1F_BRANCH_OTHER=$(_ps1_to_func "$C_BRANCH_OTHER")
PS1F_SANDBOX_LOCAL=$(_ps1_to_func "$C_SANDBOX_LOCAL")
PS1F_SANDBOX_PERSONAL=$(_ps1_to_func "$C_SANDBOX_PERSONAL")
PS1F_SANDBOX_WORK=$(_ps1_to_func "$C_SANDBOX_WORK")
PS1F_RESET=$(_ps1_to_func "$NO_COLOR")

# --- Helper functions ---

__git_branch_ps1() {
    local branch
    branch=$(git symbolic-ref --short HEAD 2>/dev/null) || return
    local c_branch=$PS1F_BRANCH_OTHER
    if [[ "$branch" =~ ^(master|main|prod)$ ]]; then
        c_branch=$PS1F_BRANCH_WARN
    fi
    printf ' %s(%s%s%s)%s' "$PS1F_HOSTNAME" "$c_branch" "$branch" "$PS1F_HOSTNAME" "$PS1F_RESET"
}

# Each dynamic segment (__sandbox_ps1, OC sections, __git_branch_ps1) owns its
# leading space. No trailing spaces. Prevents double-space when middle segments
# are empty.
export PS1="${C_HOSTNAME}\u@bob\$(__sandbox_ps1)\$(grep OCM_ENV ~/.oc/\$KUBECONFIG/data 2>/dev/null | awk -F= '{print \" ${C_OCM_ENV}\" \$2}')\$(grep OC_USER ~/.oc/\$KUBECONFIG/data 2>/dev/null | sed 's/\(kube:admin\)/${C_OC_USER_WARN}\1/g' | awk -F= '{print \" ${C_OC_USER}\" \$2}')\$(grep OC_CLUSTER ~/.oc/\$KUBECONFIG/data 2>/dev/null | awk -F= '{print \"${C_OC_AT}@${C_OC_HOST}\" \$2}')\$(grep OC_OTHER ~/.oc/\$KUBECONFIG/data 2>/dev/null | awk -F= '{print \" ${C_OC_OTHER}\" \$2}')\$(__git_branch_ps1) ${C_PWD}\W${C_PROMPT}\$${NO_COLOR} "
