# .bashrc.d/25-cursor - Cursor IDE aliases and PATH configuration
# This file is managed by ansible - user customizations go in ~/.bashrc.d/99-user

# Add ~/.local/bin to PATH if not already present
# (Most distributions already include this, but we verify to avoid duplicates)
if [ -d "$HOME/.local/bin" ] && [[ ":$PATH:" != *":$HOME/.local/bin:"* ]]; then
    export PATH="$HOME/.local/bin:$PATH"
fi

# Pin cursor-agent to specific version if configured
# This prevents auto-updates by directly calling the versioned binary
if [ -f "$HOME/.config/cursor-agent/pinned-version" ]; then
    PINNED_VERSION=$(cat "$HOME/.config/cursor-agent/pinned-version")
    if [ -f "$HOME/.local/share/cursor-agent/versions/$PINNED_VERSION/cursor-agent" ]; then
        alias cursor-agent="$HOME/.local/share/cursor-agent/versions/$PINNED_VERSION/cursor-agent"
    fi
fi

